#!/usr/bin/env bash
# release — cut a patch (default), minor, or major version of GrooveScript.
#
# Bumps pyproject.toml, commits "Bump version to X.Y.Z" on main, pushes,
# creates and pushes a lightweight tag vX.Y.Z, then opens a GitHub release.
#
# Preflight (all enforced — no --force):
#   - on main branch
#   - working tree clean
#   - local main == origin/main (after fetch)
#   - target tag vX.Y.Z does not already exist
#   - `uv run pytest` passes
#
# Usage:
#   release                                  # patch bump (X.Y.Z -> X.Y.(Z+1))
#   release --minor                          # minor bump (X.Y.Z -> X.(Y+1).0)
#   release --major                          # major bump (X.Y.Z -> (X+1).0.0)
#   release --title "vX.Y.Z — short summary" # release title (default: vX.Y.Z)
#   release --notes "<body>"                 # release body literal
#   release --notes-file <path>              # release body from file
#   release --dry-run                        # print every command without running
#   release -h | --help                      # show this help
#
# --notes and --notes-file are mutually exclusive; if neither is given the
# release is created with `gh release create --generate-notes`, which fills
# the body from merged PRs between the previous tag and this one.

set -euo pipefail

BUMP="patch"
BUMP_SET=false
TITLE=""
NOTES=""
NOTES_FILE=""
DRY_RUN=false

die() { echo "release: $*" >&2; exit 1; }

set_bump() {
    if [[ "$BUMP_SET" == true ]]; then
        die "--patch, --minor, --major are mutually exclusive"
    fi
    BUMP="$1"
    BUMP_SET=true
}

usage() {
    # Print the leading comment block as help text.
    sed -n '2,/^$/p; /^$/q' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --patch)      set_bump patch; shift ;;
        --minor)      set_bump minor; shift ;;
        --major)      set_bump major; shift ;;
        --title)      [[ $# -ge 2 ]] || die "--title needs a value"; TITLE="$2"; shift 2 ;;
        --notes)      [[ $# -ge 2 ]] || die "--notes needs a value"; NOTES="$2"; shift 2 ;;
        --notes-file) [[ $# -ge 2 ]] || die "--notes-file needs a path"; NOTES_FILE="$2"; shift 2 ;;
        --dry-run)    DRY_RUN=true; shift ;;
        -h|--help)    usage 0 ;;
        *)            echo "release: unknown flag: $1" >&2; usage 1 ;;
    esac
done

if [[ -n "$NOTES" && -n "$NOTES_FILE" ]]; then
    die "--notes and --notes-file are mutually exclusive"
fi
if [[ -n "$NOTES_FILE" && ! -f "$NOTES_FILE" ]]; then
    die "--notes-file not found: $NOTES_FILE"
fi

run() {
    if [[ "$DRY_RUN" == true ]]; then
        printf '+ '
        printf '%q ' "$@"
        printf '\n'
    else
        "$@"
    fi
}

# --- preflight ------------------------------------------------------------
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
[[ "$BRANCH" == "main" ]] || die "must be on main (currently $BRANCH)"

if ! git diff --quiet || ! git diff --cached --quiet; then
    die "working tree has uncommitted changes"
fi

echo "release: fetching origin"
run git fetch origin --quiet

if [[ "$DRY_RUN" != true ]]; then
    LOCAL_SHA="$(git rev-parse HEAD)"
    REMOTE_SHA="$(git rev-parse origin/main)"
    if [[ "$LOCAL_SHA" != "$REMOTE_SHA" ]]; then
        echo "  local : $LOCAL_SHA" >&2
        echo "  remote: $REMOTE_SHA" >&2
        die "local main is not in sync with origin/main"
    fi
fi

CURRENT="$(grep -E '^version = "[0-9]+\.[0-9]+\.[0-9]+"' pyproject.toml | head -1 \
         | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')"
[[ -n "$CURRENT" ]] || die "could not read version from pyproject.toml"

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"
case "$BUMP" in
    patch) PATCH=$((PATCH + 1)) ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
esac
NEW_VERSION="$MAJOR.$MINOR.$PATCH"
TAG="v$NEW_VERSION"

if git rev-parse --verify --quiet "refs/tags/$TAG" >/dev/null; then
    die "tag $TAG already exists locally"
fi
if git ls-remote --tags --exit-code origin "$TAG" >/dev/null 2>&1; then
    die "tag $TAG already exists on origin"
fi

GH_TITLE="${TITLE:-$TAG}"

echo "release: $CURRENT -> $NEW_VERSION ($BUMP), tag $TAG, title \"$GH_TITLE\""

# --- tests ----------------------------------------------------------------
echo "release: running uv run pytest"
run uv run pytest --quiet

# --- bump pyproject.toml --------------------------------------------------
echo "release: bumping pyproject.toml"
if [[ "$DRY_RUN" == true ]]; then
    echo "+ sed -i.bak -E 's/^version = \"[0-9.]+\"/version = \"$NEW_VERSION\"/' pyproject.toml"
else
    sed -i.bak -E "s/^version = \"[0-9]+\.[0-9]+\.[0-9]+\"/version = \"$NEW_VERSION\"/" pyproject.toml
    rm -f pyproject.toml.bak
    grep -qE "^version = \"$NEW_VERSION\"\$" pyproject.toml \
        || die "version bump failed (pyproject.toml unchanged)"
fi

# --- refresh uv.lock to match the new version -----------------------------
# pyproject's version is mirrored in uv.lock's groovescript package entry.
# Without this, uv.lock stays one release behind and gets rewritten (leaving
# a dirty working tree) the next time `uv run` syncs it.
echo "release: updating uv.lock"
run uv lock
if [[ "$DRY_RUN" != true ]]; then
    grep -qE "^version = \"$NEW_VERSION\"\$" uv.lock \
        || die "uv.lock did not pick up version $NEW_VERSION"
fi

# --- commit, push, tag, push tag -----------------------------------------
run git add pyproject.toml uv.lock
run git commit -m "Bump version to $NEW_VERSION"
run git push origin main
run git tag "$TAG"
run git push origin "$TAG"

# --- GitHub release ------------------------------------------------------
if [[ -n "$NOTES_FILE" ]]; then
    run gh release create "$TAG" --title "$GH_TITLE" --notes-file "$NOTES_FILE"
elif [[ -n "$NOTES" ]]; then
    run gh release create "$TAG" --title "$GH_TITLE" --notes "$NOTES"
else
    PREV_TAG="$(git describe --tags --abbrev=0 "$TAG^" 2>/dev/null || true)"
    if [[ -n "$PREV_TAG" ]]; then
        run gh release create "$TAG" --title "$GH_TITLE" \
            --generate-notes --notes-start-tag "$PREV_TAG"
    else
        run gh release create "$TAG" --title "$GH_TITLE" --generate-notes
    fi
fi

echo "release: done — $TAG"
