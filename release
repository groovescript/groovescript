#!/usr/bin/env bash
# release — cut a patch (default), minor, or major version of GrooveScript.
#
# Default (one step, needs push access to main and to tags): bumps
# pyproject.toml, commits "Bump version to X.Y.Z" on main, pushes, creates
# and pushes a lightweight tag vX.Y.Z, then opens a GitHub release.
#
# PR flow, for environments that can't push to the protected main branch or
# push tags (e.g. a Claude Code cloud session):
#   release --pr [--minor|--major]  # bump on a branch and open a "Bump version" PR
#   (merge the PR)                  # the Release workflow (.github/workflows/
#                                   # release.yml) then runs `release --publish`
#   release --publish [--title ...] # or by hand, on the updated main: create the
#                                   # GitHub release; GitHub creates tag vX.Y.Z on
#                                   # the server, so nothing is pushed. Needs
#                                   # permission to create releases, which Claude
#                                   # Code cloud sessions don't have
#
# Preflight (all enforced — no --force):
#   - on main branch
#   - working tree clean
#   - local main == origin/main (after fetch)
#   - target tag vX.Y.Z does not already exist
#   - `uv run pytest` passes
#
# Usage:
#   release                                  # patch bump (X.Y.Z -> X.Y.(Z+1))
#   release --minor                          # minor bump (X.Y.Z -> X.(Y+1).0)
#   release --major                          # major bump (X.Y.Z -> (X+1).0.0)
#   release --pr                             # bump via a PR instead of pushing main
#   release --branch <name>                  # PR branch name (default: release/vX.Y.Z)
#   release --publish                        # release the version already in pyproject.toml
#   release --trailer "<Key: value>"         # add a trailer to the bump commit (repeatable)
#   release --title "vX.Y.Z — short summary" # release title (default: vX.Y.Z)
#   release --notes "<body>"                 # release body literal
#   release --notes-file <path>              # release body from file
#   release --dry-run                        # print every command without running
#   release -h | --help                      # show this help
#
# --notes and --notes-file are mutually exclusive; if neither is given the
# release body is generated by GitHub from merged PRs between the previous tag
# and this one.
#
# All GitHub calls go through the REST API (`gh api`), never gh's GraphQL-
# backed subcommands, so the script also works where only REST is reachable.

set -euo pipefail

BUMP="patch"
BUMP_SET=false
TITLE=""
NOTES=""
NOTES_FILE=""
DRY_RUN=false
MODE="direct"
PR_BRANCH=""
TRAILERS=()

set_mode() {
    if [[ "$MODE" != direct ]]; then
        die "--pr and --publish are mutually exclusive"
    fi
    MODE="$1"
}

die() { echo "release: $*" >&2; exit 1; }

set_bump() {
    if [[ "$BUMP_SET" == true ]]; then
        die "--patch, --minor, --major are mutually exclusive"
    fi
    BUMP="$1"
    BUMP_SET=true
}

usage() {
    # Print the leading comment block as help text.
    sed -n '2,/^$/p; /^$/q' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --patch)      set_bump patch; shift ;;
        --minor)      set_bump minor; shift ;;
        --major)      set_bump major; shift ;;
        --title)      [[ $# -ge 2 ]] || die "--title needs a value"; TITLE="$2"; shift 2 ;;
        --notes)      [[ $# -ge 2 ]] || die "--notes needs a value"; NOTES="$2"; shift 2 ;;
        --notes-file) [[ $# -ge 2 ]] || die "--notes-file needs a path"; NOTES_FILE="$2"; shift 2 ;;
        --pr)         set_mode pr; shift ;;
        --publish)    set_mode publish; shift ;;
        --branch)     [[ $# -ge 2 ]] || die "--branch needs a name"; PR_BRANCH="$2"; shift 2 ;;
        --trailer)    [[ $# -ge 2 ]] || die "--trailer needs a value"; TRAILERS+=(--trailer "$2"); shift 2 ;;
        --dry-run)    DRY_RUN=true; shift ;;
        -h|--help)    usage 0 ;;
        *)            echo "release: unknown flag: $1" >&2; usage 1 ;;
    esac
done

if [[ -n "$NOTES" && -n "$NOTES_FILE" ]]; then
    die "--notes and --notes-file are mutually exclusive"
fi
if [[ -n "$NOTES_FILE" && ! -f "$NOTES_FILE" ]]; then
    die "--notes-file not found: $NOTES_FILE"
fi
if [[ "$MODE" == publish && "$BUMP_SET" == true ]]; then
    die "--publish releases the version already in pyproject.toml; it takes no bump flag"
fi
if [[ "$MODE" == publish && ${#TRAILERS[@]} -gt 0 ]]; then
    die "--trailer applies to the bump commit; --publish makes no commit"
fi
if [[ -n "$PR_BRANCH" && "$MODE" != pr ]]; then
    die "--branch only applies with --pr"
fi

run() {
    if [[ "$DRY_RUN" == true ]]; then
        printf '+ '
        printf '%q ' "$@"
        printf '\n'
    else
        "$@"
    fi
}

# --- preflight ------------------------------------------------------------
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
[[ "$BRANCH" == "main" ]] || die "must be on main (currently $BRANCH)"

if ! git diff --quiet || ! git diff --cached --quiet; then
    die "working tree has uncommitted changes"
fi

echo "release: fetching origin"
run git fetch origin --tags --quiet

if [[ "$DRY_RUN" != true ]]; then
    LOCAL_SHA="$(git rev-parse HEAD)"
    REMOTE_SHA="$(git rev-parse origin/main)"
    if [[ "$LOCAL_SHA" != "$REMOTE_SHA" ]]; then
        echo "  local : $LOCAL_SHA" >&2
        echo "  remote: $REMOTE_SHA" >&2
        die "local main is not in sync with origin/main"
    fi
fi

CURRENT="$(grep -E '^version = "[0-9]+\.[0-9]+\.[0-9]+"' pyproject.toml | head -1 \
         | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')"
[[ -n "$CURRENT" ]] || die "could not read version from pyproject.toml"

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"
if [[ "$MODE" != publish ]]; then
    case "$BUMP" in
        patch) PATCH=$((PATCH + 1)) ;;
        minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
        major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
    esac
fi
NEW_VERSION="$MAJOR.$MINOR.$PATCH"
TAG="v$NEW_VERSION"

if git rev-parse --verify --quiet "refs/tags/$TAG" >/dev/null; then
    die "tag $TAG already exists locally"
fi
if git ls-remote --tags --exit-code origin "$TAG" >/dev/null 2>&1; then
    die "tag $TAG already exists on origin"
fi

GH_TITLE="${TITLE:-$TAG}"

# owner/repo of origin, for REST calls (https or ssh remote URL).
REPO_SLUG="$(git remote get-url origin | sed -E 's#^(https://[^/]+/|[^@]+@[^:]+:|ssh://[^/]+/)##; s#\.git$##')"
[[ "$REPO_SLUG" == */* ]] || die "could not read owner/repo from origin's URL"

create_release() {  # create_release <target-sha-or-empty> <previous-tag-or-empty>
    # A target creates the tag on the server when it doesn't exist yet.
    local target=() body
    [[ -n "$1" ]] && target=(-f target_commitish="$1")
    if [[ -n "$NOTES_FILE" ]]; then
        body="$(cat "$NOTES_FILE")"
    elif [[ -n "$NOTES" ]]; then
        body="$NOTES"
    else
        local gen=(-f tag_name="$TAG")
        [[ -n "$1" ]] && gen+=(-f target_commitish="$1")
        [[ -n "$2" ]] && gen+=(-f previous_tag_name="$2")
        if [[ "$DRY_RUN" == true ]]; then
            run gh api -X POST "repos/$REPO_SLUG/releases/generate-notes" "${gen[@]}" --jq .body
            body="<generated notes>"
        else
            body="$(gh api -X POST "repos/$REPO_SLUG/releases/generate-notes" "${gen[@]}" --jq .body)"
        fi
    fi
    run gh api -X POST "repos/$REPO_SLUG/releases" -f tag_name="$TAG" \
        ${target[@]+"${target[@]}"} -f name="$GH_TITLE" -f body="$body" --jq .html_url
}

if [[ "$MODE" == publish ]]; then
    PREV_TAG="$(git describe --tags --abbrev=0 HEAD 2>/dev/null || true)"
    [[ "$PREV_TAG" != "$TAG" ]] || die "$TAG already tagged"
    echo "release: publishing $NEW_VERSION from main ($(git rev-parse --short HEAD)), tag $TAG, title \"$GH_TITLE\""
    echo "release: running uv run pytest"
    run uv run pytest --quiet
    # Tag on the server: the release is created with main's head as its target.
    create_release "$(git rev-parse HEAD)" "$PREV_TAG"
    run git fetch origin --tags --quiet
    echo "release: done — $TAG"
    exit 0
fi

if [[ "$MODE" == pr ]]; then
    PR_BRANCH="${PR_BRANCH:-release/$TAG}"
    if git ls-remote --heads --exit-code origin "$PR_BRANCH" >/dev/null 2>&1; then
        die "branch $PR_BRANCH already exists on origin"
    fi
fi

echo "release: $CURRENT -> $NEW_VERSION ($BUMP), tag $TAG, title \"$GH_TITLE\""

# --- tests ----------------------------------------------------------------
echo "release: running uv run pytest"
run uv run pytest --quiet

if [[ "$MODE" == pr ]]; then
    run git switch -c "$PR_BRANCH"
fi

# --- bump pyproject.toml --------------------------------------------------
echo "release: bumping pyproject.toml"
if [[ "$DRY_RUN" == true ]]; then
    echo "+ sed -i.bak -E 's/^version = \"[0-9.]+\"/version = \"$NEW_VERSION\"/' pyproject.toml"
else
    sed -i.bak -E "s/^version = \"[0-9]+\.[0-9]+\.[0-9]+\"/version = \"$NEW_VERSION\"/" pyproject.toml
    rm -f pyproject.toml.bak
    grep -qE "^version = \"$NEW_VERSION\"\$" pyproject.toml \
        || die "version bump failed (pyproject.toml unchanged)"
fi

# --- refresh uv.lock to match the new version -----------------------------
# pyproject's version is mirrored in uv.lock's groovescript package entry.
# Without this, uv.lock stays one release behind and gets rewritten (leaving
# a dirty working tree) the next time `uv run` syncs it.
echo "release: updating uv.lock"
run uv lock
if [[ "$DRY_RUN" != true ]]; then
    grep -qE "^version = \"$NEW_VERSION\"\$" uv.lock \
        || die "uv.lock did not pick up version $NEW_VERSION"
fi

# --- commit (and, for --pr, open the bump PR) ----------------------------
run git add pyproject.toml uv.lock
run git commit -m "Bump version to $NEW_VERSION" ${TRAILERS[@]+"${TRAILERS[@]}"}

if [[ "$MODE" == pr ]]; then
    run git push -u origin "$PR_BRANCH"
    run gh api -X POST "repos/$REPO_SLUG/pulls" -f base=main -f head="$PR_BRANCH" \
        -f title="Bump version to $NEW_VERSION" \
        -f body="Bumps pyproject.toml and uv.lock to $NEW_VERSION for release $TAG.

Merging it runs the Release workflow, which creates the $TAG tag and GitHub release (\`./release --publish\` on an up-to-date main does the same by hand)." \
        --jq .html_url
    run git switch main
    echo "release: opened the bump PR for $TAG — merging it publishes the release (Release workflow)"
    exit 0
fi

# --- push, tag, push tag ---------------------------------------------------
run git push origin main
run git tag "$TAG"
run git push origin "$TAG"

# --- GitHub release ------------------------------------------------------
create_release "" "$(git describe --tags --abbrev=0 "$TAG^" 2>/dev/null || true)"

echo "release: done — $TAG"
