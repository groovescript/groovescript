// GrooveScript grammar — Iteration 12: inferred subdivisions + *N star syntax

%import common.ESCAPED_STRING
%import common.INT

start: statement*

?statement: metadata_block
          | metadata_line
          | groove_def
          | section_def
          | fill_def
          | variation_def
          | top_level_crash_in_line

// Top-level ``crash in`` directive: every section after the first gets a
// bar-1 crash-in by default. A section can opt out with ``no crash in``.
top_level_crash_in_line: CRASH_IN

metadata_block: "metadata" ":" metadata_line+
metadata_line: title_line
             | tempo_line
             | time_signature_line
             | dsl_version_line
             | default_groove_line
             | default_bars_line
             | feel_line

title_line: "title" ":" ESCAPED_STRING
tempo_line: "tempo" ":" INT
time_signature_line: "time_signature" ":" TIME_SIGNATURE
dsl_version_line: "dsl_version" ":" INT
default_groove_line: "default_groove" ":" ESCAPED_STRING
default_bars_line: "default_bars" ":" INT
feel_line: "feel" ":" FEEL_VALUE
FEEL_VALUE: "swing"

groove_def: "groove" ESCAPED_STRING ":" groove_body
          | "groove" "placeholder" ESCAPED_STRING                  -> groove_placeholder_def
groove_body: pattern_content
           | groove_cn_body
           | extend_body
extend_body: "extend" ":" ESCAPED_STRING
           | "extend" ":" ESCAPED_STRING pattern_content
           | "extend" ":" ESCAPED_STRING extend_body_item+
           | "extend" ":" ESCAPED_STRING pattern_content extend_body_item+
?extend_body_item: variation_action
                 | extend_variation_block
                 | extend_bar_text
extend_bar_text: "text" ":" ESCAPED_STRING
extend_variation_block: "variation" "at" "bar" bar_number_list ":" variation_action+
                      | "variation" "at" "bars" bar_number_list ":" variation_action+
groove_cn_body: "count" ":" ESCAPED_STRING "notes" ":" ESCAPED_STRING
pattern_content: pattern_block_line+ groove_dynamic_line*
               | pattern_bar+ groove_dynamic_line*
groove_dynamic_line: section_dynamic_line
?pattern_block_line: pattern_line | groove_pos_line
pattern_bar: "bar" INT ":" pattern_bar_item+
?pattern_bar_item: pattern_line | groove_pos_line | pattern_bar_text | bar_like_line
bar_like_line: "like" ":" "bar" INT
pattern_bar_text: "text" ":" ESCAPED_STRING
pattern_line: INSTRUMENT ":" pattern_value      // instrument→positions: BD: 1, 3
groove_pos_line: BEAT_LABEL ":" fill_instruments // position→instruments: 1: BD, HH

fill_def: "fill" ESCAPED_STRING ":" fill_extend_clause fill_bar_block* fill_dynamic_line*
        | "fill" ESCAPED_STRING ":" fill_bar_block+ fill_dynamic_line*
        | "fill" ESCAPED_STRING ":" fill_extend_clause fill_count_item+ fill_dynamic_line* -> fill_def_extend_bare
        | "fill" ESCAPED_STRING ":" fill_count_item+ fill_dynamic_line* -> fill_def_bare
fill_extend_clause: "extend" ":" ESCAPED_STRING
fill_dynamic_line: section_dynamic_line
?fill_bar_block: fill_count_block | fill_cn_bar | fill_bar_numbered
fill_count_block: "count" ESCAPED_STRING ":" fill_count_item+
fill_bar_numbered: "bar" INT ":" fill_count_item+
fill_cn_bar: "count" ":" ESCAPED_STRING ("notes" ":" ESCAPED_STRING)?
?fill_count_item: fill_line | fill_instr_line
fill_line: BEAT_LABEL ":" fill_instruments       // position→instruments: 3: SN, BD
fill_instr_line: INSTRUMENT ":" pattern_value     // instrument→positions: BD: 1, 3 or BD: *8 except 4&
fill_instrument_hit: INSTRUMENT MODIFIER*
fill_instruments: fill_instrument_hit ("," fill_instrument_hit)*

section_def: "section" ESCAPED_STRING ":" section_line*
section_line: bars_line
            | groove_line
            | repeat_line
            | like_line
            | section_fill_line
            | section_fill_placeholder_line
            | section_variation_block
            | section_cue_line
            | section_tempo_line
            | section_time_signature_line
            | section_dynamic_line
            | section_crash_in_line
            | section_break_line
            | play_block
bars_line: "bars" ":" INT
groove_line: "groove" ":" ESCAPED_STRING
           | "groove" ":" groove_body
           | "groove" ":" "placeholder"                            -> groove_line_placeholder
           | "groove" ":" "placeholder" ESCAPED_STRING              -> groove_line_placeholder_named
repeat_line: "repeat" ":" INT
like_line: "like" ESCAPED_STRING ("with" INHERIT_CATEGORY (","? INHERIT_CATEGORY)*)?
INHERIT_CATEGORY: "fills" | "variations" | "cues"
section_tempo_line: "tempo" ":" INT
section_time_signature_line: "time_signature" ":" TIME_SIGNATURE
// Flag line: replace the first cymbal/riding hit of one or more bars in
// this section with a crash. See `_apply_crash_in` in compiler.py. The
// terminals are single multi-word regexes so the ``crash`` and ``no``
// keywords don't shadow other tokens inside pattern lines.
section_crash_in_line: CRASH_IN
                     | CRASH_IN "at" bar_number_list   -> section_crash_in_at_bars
                     | CRASH_IN "at" STAR_VALUE        -> section_crash_in_at_star
                     | NO_CRASH_IN                     -> section_no_crash_in_line
CRASH_IN: /crash\s+in/
NO_CRASH_IN: /no\s+crash\s+in/

// Silence a range of beats/bars within a section.
// Four user-facing forms (the ``beat`` clauses are optional on either end):
//   break on bar 3
//   break on bar 3 beat 3
//   break on bar 3 beat 3 through bar 5
//   break on bar 3 beat 3 through bar 5 beat 2
// All six combinations of present/absent start-beat × present/absent end-bar/beat
// are supported via separate rule aliases so the Transformer can read tokens
// positionally without ambiguity.
section_break_line: "break" "on" "bar" INT                                                                          -> section_break_bar
                  | "break" "on" "bar" INT "beat" BEAT_LABEL                                                         -> section_break_bar_beat
                  | "break" "on" "bar" INT "through" "bar" INT                                                       -> section_break_range
                  | "break" "on" "bar" INT "beat" BEAT_LABEL "through" "bar" INT                                     -> section_break_beat_range
                  | "break" "on" "bar" INT "through" "bar" INT "beat" BEAT_LABEL                                     -> section_break_range_beat
                  | "break" "on" "bar" INT "beat" BEAT_LABEL "through" "bar" INT "beat" BEAT_LABEL  -> section_break_full_range
                  | "break" "on" "bar" INT "until" "bar" INT                                                         -> section_break_until_range
                  | "break" "on" "bar" INT "beat" BEAT_LABEL "until" "bar" INT                                       -> section_break_until_beat_range
                  | "break" "on" "bar" INT "until" "bar" INT "beat" BEAT_LABEL                                       -> section_break_until_range_beat
                  | "break" "on" "bar" INT "beat" BEAT_LABEL "until" "bar" INT "beat" BEAT_LABEL    -> section_break_until_full_range

play_block: "play" ":" play_item+
?play_item: play_groove | play_bar | play_rest
play_groove: "groove" ESCAPED_STRING repeat_count?                   -> play_groove_named
           | "groove" ESCAPED_STRING repeat_count? ":" groove_body   -> play_groove_named_inline
           | "groove" repeat_count? ":" groove_body                  -> play_groove_inline
           | "groove" "placeholder" repeat_count?                    -> play_groove_placeholder
           | "groove" "placeholder" ESCAPED_STRING repeat_count?     -> play_groove_placeholder_named
play_bar:    "bar"    ESCAPED_STRING repeat_count? play_bar_body?
play_rest:   "rest"                  repeat_count?
play_bar_body: ":" pattern_bar_item+
repeat_count: "x" INT
section_fill_line: "fill" ESCAPED_STRING "at" "bar" bar_number_list
                 | "fill" ESCAPED_STRING "at" "bar" bar_number_list "beat" BEAT_LABEL
                 | "fill" ESCAPED_STRING "at" "bars" bar_number_list
                 | "fill" ESCAPED_STRING "at" "bars" bar_number_list "beat" BEAT_LABEL
                 | "fill" "at" "bar" bar_number_list ":" fill_bar_block+ fill_dynamic_line*
                 | "fill" "at" "bar" bar_number_list ":" fill_count_item+ fill_dynamic_line*              -> section_inline_fill_bare
                 | "fill" "at" "bar" bar_number_list "beat" BEAT_LABEL ":" fill_bar_block+ fill_dynamic_line*
                 | "fill" "at" "bar" bar_number_list "beat" BEAT_LABEL ":" fill_count_item+ fill_dynamic_line* -> section_inline_fill_bare
                 | "fill" "at" "bars" bar_number_list ":" fill_bar_block+ fill_dynamic_line*
                 | "fill" "at" "bars" bar_number_list ":" fill_count_item+ fill_dynamic_line*            -> section_inline_fill_bare
                 | "fill" "at" "bars" bar_number_list "beat" BEAT_LABEL ":" fill_bar_block+ fill_dynamic_line*
                 | "fill" "at" "bars" bar_number_list "beat" BEAT_LABEL ":" fill_count_item+ fill_dynamic_line* -> section_inline_fill_bare
// ``fill at bar N`` with no body or reference renders as a placeholder
// labelled "Fill" — the minimal syntax for marking "something happens here"
// while building a chart iteratively.
section_fill_placeholder_line: "fill" "placeholder" "at" "bar" INT
                              | "fill" "placeholder" ESCAPED_STRING "at" "bar" INT
                              | "fill" "placeholder" "at" "bar" INT "beat" BEAT_LABEL
                              | "fill" "placeholder" ESCAPED_STRING "at" "bar" INT "beat" BEAT_LABEL
                              | "fill" "at" "bar" bar_number_list                         -> section_empty_fill_placeholder
                              | "fill" "at" "bar" bar_number_list "beat" BEAT_LABEL       -> section_empty_fill_placeholder
section_cue_line: "cue" ESCAPED_STRING "at" "bar" INT
                | "cue" ESCAPED_STRING "at" "bar" INT "beat" BEAT_LABEL
section_dynamic_line: DYNAMIC_KIND "from" "bar" INT "to" "bar" INT
                    | DYNAMIC_KIND "from" "bar" INT "beat" BEAT_LABEL "to" "bar" INT
                    | DYNAMIC_KIND "from" "bar" INT "to" "bar" INT "beat" BEAT_LABEL
                    | DYNAMIC_KIND "from" "bar" INT "beat" BEAT_LABEL "to" "bar" INT "beat" BEAT_LABEL
                    | DYNAMIC_KIND "bar" INT
// Longer alternatives must precede their prefixes so Python regex takes the full token.
DYNAMIC_KIND: "crescendo" | "decrescendo" | "cresc" | "decresc"

// Top-level reusable variation definition. Referenced from a section via
// `variation "name" at bar N` (no trailing body). User-defined names
// override the built-in variation library.
variation_def: "variation" ESCAPED_STRING ":" variation_action+

section_variation_block: "variation" ESCAPED_STRING "at" "bar" bar_number_list ":" variation_action+
                       | "variation" "at" "bar" bar_number_list ":" variation_action+
                       | "variation" ESCAPED_STRING "at" "bars" bar_number_list ":" variation_action+
                       | "variation" "at" "bars" bar_number_list ":" variation_action+
                       | "variation" ESCAPED_STRING "at" "bar" bar_number_list   -> section_variation_ref
                       | "variation" ESCAPED_STRING "at" "bars" bar_number_list  -> section_variation_ref
bar_number_list: INT ("," INT)*
?variation_action: add_action | remove_action | replace_action | substitute_action | modify_action | variation_time_signature_action
variation_time_signature_action: "time_signature" ":" TIME_SIGNATURE
add_action: "add" add_instr_spec+ "at" variation_target
add_instr_spec: INSTRUMENT MODIFIER*
remove_action: "remove" INSTRUMENT+ "at" variation_target
replace_action: "replace" INSTRUMENT+ "with" replace_instr_spec+ "at" variation_target
replace_instr_spec: INSTRUMENT MODIFIER*
substitute_action: "count" ":" ESCAPED_STRING "notes" ":" ESCAPED_STRING
modify_action: "modify" "add" MODIFIER+ "to" INSTRUMENT "at" variation_target       -> modify_add_action
             | "modify" "remove" MODIFIER+ "from" INSTRUMENT "at" variation_target  -> modify_remove_action

?pattern_value: STAR_VALUE "except" beat_list -> star_except
              | STAR_VALUE -> star
              | TUPLET_STAR ("except" beat_list)? -> tuplet_star
              | beat_list

// ``*<kind>[/N]`` — fill the bar with one tuplet of the named kind per
// beat. The ``/8`` qualifier (and rare ``/16``) makes each beat carry two
// (or four) half-beat tuplets back-to-back; bare ``*<kind>`` defaults to
// one whole-beat tuplet per beat.
TUPLET_STAR: /\*(triplet|quintuplet|sextuplet|septuplet|nonuplet)(\/[0-9]+)?/

// Variation actions accept a bare ``*`` as "all beats" in addition to a beat list.
?variation_target: BARE_STAR -> variation_star
                 | beat_list
BARE_STAR: "*"

beat_list: beat_or_tuplet ("," beat_or_tuplet)*
?beat_or_tuplet: beat | tuplet_group
beat: BEAT_LABEL MODIFIER*

// Tuplet group: a beat-list entry that anchors at a beat label and
// expands into N evenly-spaced slots over the beat (or a half-beat span
// when the kind is qualified with ``/8``). Slot indices inside are 1..N
// with optional modifiers, comma-separated like an ordinary beat list.
//   2{sextuplet 1, 2, 3, 4, 5, 6}     → six even hits across beat 2
//   2&{triplet/8 1, 3}                → two hits inside beat 2&'s 8th-note triplet
tuplet_group: BEAT_LABEL "{" TUPLET_KIND ("/" INT)? tuplet_slot ("," tuplet_slot)* "}"
tuplet_slot: INT MODIFIER*
TUPLET_KIND: "triplet" | "quintuplet" | "sextuplet" | "septuplet" | "nonuplet"

// Canonical abbreviations plus common long-form and lowercase aliases.
// Longer alternatives must precede any of their prefixes in the alternation
// so that Python regex takes the full token (e.g. "snare" before "sn",
// "crash2" before "crash", "splash" before "sp", "stack" before "st",
// "china" before "ch", "CR2" before "CR").
// cr(?!esc) prevents the 'cr' abbreviation from consuming the first two chars
// of the 'cresc' dynamic keyword before the lexer can match DYNAMIC_KIND.
INSTRUMENT: /SCS|cross-stick|floortom|hightom|hitom|lowtom|midtom|openhat|hihatfoot|footchick|hihat|snare|secondcrash|splash|stack|china|crash2|crash|click|ridebell|cowbell|bell|ride|bass|kick|open|hat|BD|bd|SN|sn|OH|oh|RD|rd|RB|rb|CR2|cr2|CR|cr(?!esc)|CB|cb|CH|ch|FT|ft|HH|hh|HT|ht|MT|mt|HF|hf|SP|sp|ST|st/
TIME_SIGNATURE: /[0-9]+\/[0-9]+/
// [e&a] = 16th suffixes; [tl] = triplet (trip/let) suffixes; beats 1-99 to cover
// compound meters (12/8, 10/8, 11/8, 12/16, …) as well as odd meters.
// "and" is a long-form alias for "&" (e.g. "1and" ↔ "1&")
BEAT_LABEL: /[1-9][0-9]?(trip|let|and|[e&atl])?/ | /trip/ | /let/ | /and/
// flam / drag accept an optional ``:<instrument>`` suffix that names the
// instrument the grace stroke(s) play on (e.g. ``flam:SN`` for a hi-tom hit
// with a snare grace). The suffix tokenises as part of the modifier so the
// LALR grammar still sees a single MODIFIER terminal; the transformer splits
// off the instrument name and the compiler validates it.
MODIFIER: "ghost" | "accent" | "choke" | "fermata" | /flam(?::[A-Za-z-]+)?/ | /drag(?::[A-Za-z-]+)?/ | "double" | /buzz(?::[1-9][0-9]?d{0,2})?/
// *N = "every 1/N note"; optional 't' suffix marks a triplet grid
// (e.g. *8t = 8th-note triplets, *4t = quarter-note triplets).
STAR_VALUE: /\*(2|4|8|16)t?/

%ignore /\s+/
%ignore /\/\/[^\n]*/
%ignore /#[^\n]*/
